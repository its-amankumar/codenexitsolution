@{
    ViewData["Title"] = "AboutPage";
}

<!-- Page Title -->
<div class="page-title accent-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">About</h1>
        <nav class="breadcrumbs">
            <ol>
              <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">About</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- About Section -->
<section id="about" class="about section">

    <div class="container">

        <!-- Intro -->
        <div class="row align-items-center mb-5 position-relative">

            <!-- Image -->
            <div class="col-lg-6 about-img" data-aos="zoom-out" data-aos-delay="200">
                <img src="~/assets/img/about2.png"    alt="CodNexIT Solution"         class="img-fluid">
            </div> 

            <!-- Intro Content -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                <h2 class="about-main-title fw-bold">
                    Building Better Digital Solutions for Businesses
                </h2>
                <div class="our-story">

                    <h4>Discover CodNexIT Solution</h4>

                    <h3>Our Approach</h3>

                    <p>
                        At CodNexIT Solution, we understand that every business has
                        different goals, challenges and customers. We take a
                        requirement-driven approach to create digital solutions that
                        are aligned with the specific needs of each business.
                    </p>

                    <p>
                        Our focus is not just on developing a website or software.
                        We aim to create digital experiences that are easy to use,
                        visually appealing, reliable and capable of supporting
                        business growth.
                    </p>

                    @* <h3>Technology & Creativity</h3>

                    <p>
                        We bring technology and creativity together to deliver complete
                        digital solutions. Our expertise covers web development,
                        software development, WordPress, graphic design, video editing
                        and social media marketing.
                    </p> *@

                   @*  <h3>Our Commitment</h3>

                    <p>
                        We believe in maintaining clear communication, understanding
                        client requirements and delivering quality work. Our goal is to
                        build long-term relationships by providing dependable solutions
                        and continuous support.
                    </p> *@

                </div>

                <!-- Image -->
             
                </div>
      <div class="col-lg-12" data-aos="fade-up" data-aos-delay="100">
        <!-- What We Do -->
        <div class="row mb-5" data-aos="fade-up">

            <div class="col-12">

                <div class="our-story">

                    <h3>What We Do</h3>

                    <p>
                        We provide technology and creative services designed
                        to meet the changing needs of modern businesses.
                        Our solutions focus on usability, performance,
                        professional design and long-term value.
                    </p>

                    <div class="row">

                        <div class="col-md-6">
                            <ul>
                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Website & Web Application Development</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Custom Software & Business Solutions</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>WordPress Website Development</span>
                                </li>
                            </ul>
                        </div>

                        <div class="col-md-6">
                            <ul>
                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Graphic Design & Creative Content</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Video Editing & Social Media Content</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Social Media Marketing & Digital Branding</span>
                                </li>
                            </ul>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Mission & Vision -->
        <div class="row mb-5" data-aos="fade-up">

            <div class="col-lg-6">
                <div class="our-story">

                    <h3>Our Mission</h3>

                    <p>
                        Our mission is to provide reliable, creative and
                        affordable digital solutions that help businesses
                        build a strong online presence and achieve their
                        goals through technology.
                    </p>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="our-story">

                    <h3>Our Vision</h3>

                    <p>
                        Our vision is to become a trusted digital technology
                        partner for businesses by delivering innovative
                        solutions, maintaining high standards of quality
                        and building long-term relationships with our clients.
                    </p>

                </div>
            </div>

        </div>


        <!-- Why Choose Us -->
        <div class="row mb-5" data-aos="fade-up">

            <div class="col-12">

                <div class="our-story">

                    <h3>Why Choose Us?</h3>

                    <p>
                        We believe every business has different requirements.
                        That's why we focus on understanding your goals before
                        creating a solution.
                    </p>

                    <div class="row">

                        <div class="col-md-6">
                            <ul>
                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Client-focused and customized solutions</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Modern and scalable technology</span>
                                </li>
                            </ul>
                        </div>

                        <div class="col-md-6">
                            <ul>
                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Creative and professional approach</span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle"></i>
                                    <span>Quality, reliability and timely delivery</span>
                                </li>
                            </ul>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Final Content -->
        <div class="row" data-aos="fade-up">

            <div class="col-12">

                <div class="our-story">

                    <h3>Building Digital Experiences That Matter</h3>

                    <p>
                        At CodNexIT Solution, we believe technology should
                        simplify business, improve customer engagement and
                        create new opportunities for growth. We work closely
                        with our clients to transform ideas into meaningful
                        digital experiences that deliver real value.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
<!-- /About Section -->


       

    <!-- Clients Section -->
        <section id="clients" class="clients section">

            <!-- Section Title -->
            <div class="container section-title" data-aos="fade-up">
                <div class="container section-title" data-aos="fade-up">
                    <h2>Our Clients</h2>
                    <p>We are proud to work with trusted clients and partners who believe in our services and expertise.</p>
                </div>
            <div class="container" data-aos="fade-up" data-aos-delay="100">

                <div class="swiper clients-slider">
                    <div class="swiper-wrapper">

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/juvena.png" class="img-fluid" alt="Juvena">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/24logo.png" class="img-fluid" alt="24 Logo">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/shreyanshlogo.png" class="img-fluid" alt="Shreyansh">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/bjplogo.png" class="img-fluid" alt="BJP">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/fitt-logo.png" class="img-fluid" alt="Fitt">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/chandanlogo.png" class="img-fluid" alt="Chandan">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/unitechhub.png" class="img-fluid" alt="Unitech Hub">
                        </div>

                        <div class="swiper-slide client-logo">
                            <img src="~/assets/img/clients/AWgif.gif" class="img-fluid" alt="AW">
                        </div>

                    </div>

                    <!-- Optional Pagination -->
                    <div class="swiper-pagination"></div>
                </div>

            </div>

        </section>


        <script>
            document.addEventListener("DOMContentLoaded", function () {

                new Swiper(".clients-slider", {
                    loop: true,
                    centeredSlides: true,
                    slidesPerView: 3,
                    spaceBetween: 25,

                    autoplay: {
                        delay: 2000,
                        disableOnInteraction: false
                    },

                    speed: 800,

                    pagination: {
                        el: ".clients-slider .swiper-pagination",
                        clickable: true
                    },

                    breakpoints: {
                        0: {
                            slidesPerView: 1.5,
                            spaceBetween: 15
                        },
                        576: {
                            slidesPerView: 2.5,
                            spaceBetween: 20
                        },
                        992: {
                            slidesPerView: 3,
                            spaceBetween: 25
                        },
                        1200: {
                            slidesPerView: 4,
                            spaceBetween: 30
                        }
                    }
                });

            });
        </script>

<!-- /Clients Section -->