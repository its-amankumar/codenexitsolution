@{
    ViewData["Title"] = "Price Page";
}
<!-- Page Title -->
<div class="page-title accent-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">Pricing</h1>
        <nav class="breadcrumbs">
            <ol>
              <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="current">Pricing</li>
            </ol>
        </nav>
    </div>
</div><!-- End Page Title -->
<!-- Pricing Section -->
<section id="pricing" class="pricing section">

    <div class="container">

        <div class="row gy-4">

            <!-- Basic -->
            <div class="col-lg-4" data-aos="zoom-in" data-aos-delay="100">
                <div class="pricing-item">
                    <h3>Basic Website</h3>
                    <p class="description">
                        Perfect for small businesses and startups.
                    </p>

                    <h4><sup>₹</sup>7,999<span> onwards</span></h4>

                    <a href="#contact" class="cta-btn">Get Started</a>

                    <p class="text-center small">Free consultation included</p>

                    <ul>
                        <li><i class="bi bi-check"></i> <span>Responsive Website</span></li>
                        <li><i class="bi bi-check"></i> <span>Up to 5 Pages</span></li>
                        <li><i class="bi bi-check"></i> <span>Mobile Friendly Design</span></li>
                        <li><i class="bi bi-check"></i> <span>Contact Form</span></li>
                        <li><i class="bi bi-check"></i> <span>Basic SEO</span></li>
                        <li class="na"><i class="bi bi-x"></i> <span>Admin Panel</span></li>
                        <li class="na"><i class="bi bi-x"></i> <span>Advanced Features</span></li>
                    </ul>
                </div>
            </div>

            <!-- Business -->
            <div class="col-lg-4" data-aos="zoom-in" data-aos-delay="200">
                <div class="pricing-item featured">

                    <p class="popular">Popular</p>

                    <h3>Business Website</h3>

                    <p class="description">
                        Ideal for growing businesses and professional companies.
                    </p>

                    <h4><sup>₹</sup>14,999<span> onwards</span></h4>

                    <a href="#contact" class="cta-btn">Get Started</a>

                    <p class="text-center small">Free consultation included</p>

                    <ul>
                        <li><i class="bi bi-check"></i> <span>Responsive Website</span></li>
                        <li><i class="bi bi-check"></i> <span>Up to 10 Pages</span></li>
                        <li><i class="bi bi-check"></i> <span>Modern UI/UX Design</span></li>
                        <li><i class="bi bi-check"></i> <span>Contact & Enquiry Forms</span></li>
                        <li><i class="bi bi-check"></i> <span>Basic SEO</span></li>
                        <li><i class="bi bi-check"></i> <span>Social Media Integration</span></li>
                        <li class="na"><i class="bi bi-x"></i> <span>Advanced Web Application</span></li>
                    </ul>
                </div>
            </div>

            <!-- Premium -->
            <div class="col-lg-4" data-aos="zoom-in" data-aos-delay="300">
                <div class="pricing-item">

                    <h3>Custom Solution</h3>

                    <p class="description">
                        Advanced websites and custom software solutions.
                    </p>

                    <h4><span>Let's Talk</span></h4>

                    <a href="#contact" class="cta-btn">Contact Us</a>

                    <p class="text-center small">Customized according to your requirements</p>

                    <ul>
                        <li><i class="bi bi-check"></i> <span>Custom Website</span></li>
                        <li><i class="bi bi-check"></i> <span>ASP.NET / .NET Core</span></li>
                        <li><i class="bi bi-check"></i> <span>Custom Web Applications</span></li>
                        <li><i class="bi bi-check"></i> <span>Database Integration</span></li>
                        <li><i class="bi bi-check"></i> <span>Admin Dashboard</span></li>
                        <li><i class="bi bi-check"></i> <span>API Development</span></li>
                        <li><i class="bi bi-check"></i> <span>Business Automation</span></li>
                    </ul>

                </div>
            </div>

        </div>

    </div>

</section>