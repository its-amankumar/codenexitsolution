                 data-aos-delay="200">

                <img src="~/assets/img/about3.png"
                     alt="CodNexIT Solution">

            </div>

            <!-- About Content -->
            <div class="col-lg-6"
                 data-aos="fade-up"
                 data-aos-delay="100">

                <h2 class="inner-title">
                    Your Trusted Digital Solutions Partner
                </h2>

                <p class="inner-subtitle">
                    We turn your ideas into powerful digital experiences.
                </p>

                <div class="our-story">

                    <h4>CodNexIT Solution</h4>

                    <h3>Who We Are</h3>

                    <p>
                        CodNexIT Solution is a digital solutions company
                        focused on helping businesses build, grow and
                        strengthen their digital presence.
                    </p>

                    <ul>
                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>Professional Web Development Solutions</span>
                        </li>

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>Custom Software Development</span>
                        </li>

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>Creative Graphic Design &amp; Video Editing</span>
                        </li>

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>Social Media Marketing &amp; Digital Branding</span>
                        </li>
                    </ul>

                   @*  <p>
                        We combine technology, creativity and digital
