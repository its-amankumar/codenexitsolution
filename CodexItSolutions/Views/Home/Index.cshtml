@{
    ViewData["Title"] = "Home Page";
}

<main class="main">

<!-- Hero Section -->
<section id="hero" class="hero section dark-background">

    <!-- ================= DESKTOP CAROUSEL ================= -->
    <div id="hero-carousel-desktop"
         class="carousel slide carousel-fade desktop-hero"
         data-bs-ride="carousel"
         data-bs-interval="5000">

        <!-- Desktop Banner 1 -->
        <div class="carousel-item active">
            <img src="~/assets/img/hero-carousel/banner1.jpeg"
                 alt="Web Development">
        </div>

        <!-- Desktop Banner 2 -->
        <div class="carousel-item">
            <img src="~/assets/img/hero-carousel/banner3.png"
                 alt="Digital Marketing">
        </div>

        <a class="carousel-control-prev"
           href="#hero-carousel-desktop"
           role="button"
           data-bs-slide="prev">

            <span class="carousel-control-prev-icon bi bi-chevron-left"
                  aria-hidden="true"></span>
        </a>

        <a class="carousel-control-next"
           href="#hero-carousel-desktop"
           role="button"
           data-bs-slide="next">

            <span class="carousel-control-next-icon bi bi-chevron-right"
                  aria-hidden="true"></span>
        </a>

    </div>


    <!-- ================= MOBILE CAROUSEL ================= -->
    <div id="hero-carousel-mobile"
         class="carousel slide carousel-fade mobile-hero"
         data-bs-ride="carousel"
         data-bs-interval="5000">

        <!-- Mobile Banner 1 -->
        <div class="carousel-item active">
            <img src="~/assets/img/hero-carousel/mobile-banner.png"
                 alt="Codnex IT Solution">
        </div>

        <!-- Mobile Banner 2 -->
        <div class="carousel-item">
            <img src="~/assets/img/hero-carousel/mobile-banner3.png"
                 alt="Codnex IT Solution">
        </div>

        <a class="carousel-control-prev"
           href="#hero-carousel-mobile"
           role="button"
           data-bs-slide="prev">

            <span class="carousel-control-prev-icon bi bi-chevron-left"
                  aria-hidden="true"></span>
        </a>

        <a class="carousel-control-next"
           href="#hero-carousel-mobile"
           role="button"
           data-bs-slide="next">

            <span class="carousel-control-next-icon bi bi-chevron-right"
                  aria-hidden="true"></span>
        </a>

    </div>

</section>
<!-- /Hero Section -->

<!-- About Section -->
<section id="about" class="about section">

    <div class="container">

        <div class="row position-relative align-items-center">

            <!-- About Image -->
            <div class="col-lg-6 about-img"
